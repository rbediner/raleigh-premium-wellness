# macOS metadata files do not belong in version control.
.DS_Store

# Node-based tooling may be added later for local development and testing.
node_modules/
dist/
coverage/
playwright-report/
test-results/

# Local Google Drive shortcut files are useful working references, but they are
# not stable cross-machine repo state, so we leave them untracked rather than
# deleting them during cleanup work. Stable project links live as checked-in
# .webloc and markdown reference files.
*.gdoc
*.gsheet
*.gslides

# Apps Script local bindings should stay machine-local until the team confirms
# the correct owner account and the canonical script project to bind against.
integrations/**/.clasp.json

# Root-level review screenshots are usually ad hoc local artifacts. Committed
# QA evidence should live in a dated subfolder under assets/review-screenshots/.
/assets/review-screenshots/*.png
/assets/review-screenshots/*.json

# Keep this local ad hoc UX review file out of the readiness gate unless the
# team decides to move it into a purpose-driven docs folder later.
/RPW_UX_QA_Review.docx
