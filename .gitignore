# macOS metadata files do not belong in version control.
.DS_Store

# Node-based tooling may be added later for local development and testing.
node_modules/
dist/
coverage/
playwright-report/
test-results/

# Local Google Drive shortcut files are convenient on one machine but unstable
# across cloud-synced machines, so we do not track .gdoc or .gsheet artifacts.
# Stable project links live as checked-in .webloc and markdown reference files.
*.gdoc
*.gsheet
